<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nb_bg</item>
        <item name="android:statusBarColor">@color/nb_bg</item>
        <item name="android:navigationBarColor">@color/nb_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/nb_gold</item>
        <item name="android:alertDialogTheme">@style/NbDialog</item>
    </style>

    <style name="NbDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorBackground">@color/nb_surface</item>
        <item name="android:colorAccent">@color/nb_gold</item>
        <item name="android:textColorPrimary">@color/nb_text</item>
        <item name="android:textColorSecondary">@color/nb_dim</item>
    </style>
</resources>
